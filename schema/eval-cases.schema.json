{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exemplar.internal/schema/eval-cases.schema.json",
  "title": "EvalCases",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule", "cases"],
  "properties": {
    "rule": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ref", "expect"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "pattern": "^[^/@\\s]+/[^/@\\s]+@[0-9a-f]{7,40}$" },
          "synthetic": { "type": "boolean" },
          "patch": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array", "maxItems": 20, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 },
            "description": "Files the rule runs on. Defaults to the expect paths; negatives need it."
          },
          "expect": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "lines"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "lines": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "if": { "properties": { "synthetic": { "const": true } }, "required": ["synthetic"] },
        "then": { "required": ["patch"] }
      }
    }
  }
}
