{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exemplar.internal/schema/repo.schema.json",
  "title": "RepoConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled"],
  "$defs": {
    "globs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "repos": { "type": "array", "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" } },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "properties": {
    "enabled": { "type": "boolean" },
    "review_drafts": { "type": "boolean" },
    "shadow": { "type": "boolean", "description": "Review in shadow (spec §6.9): every lane runs and results are stored, but nothing is written to the PR (no comments, check runs or approval). For pilots (spec §16 Phase 2)." },
    "forks": {
      "type": "object", "additionalProperties": false, "required": ["review"],
      "properties": { "review": { "type": "boolean" } }
    },
    "sensitive_paths": { "$ref": "#/$defs/globs" },
    "disabled_global_rules": { "type": "array", "items": { "type": "string" } },
    "linters": { "type": "array", "items": { "type": "string" } },
    "bug_lane": {
      "type": "object", "additionalProperties": false,
      "properties": { "critical_paths": { "$ref": "#/$defs/globs" } }
    },
    "exports": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "targets": { "type": "array", "items": { "enum": ["agents_md", "claude_md", "copilot", "cursor"] } },
        "auto_merge_generated": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "extra_repos": { "$ref": "#/$defs/repos" },
        "include_roots": { "type": "array", "items": { "type": "string" } },
        "dependents_depth": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "auto_approve": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "paths": { "$ref": "#/$defs/globs" },
        "allowed_authors": { "type": "array", "items": { "type": "string" } },
        "approvable_owners": {
          "type": "array",
          "description": "CODEOWNERS owners whose paths may be auto-approved (Stage 2, spec §6.13): every touched path's owners must all be listed. Empty approves nothing.",
          "items": { "type": "string", "pattern": "^(@[A-Za-z0-9][A-Za-z0-9-]*(/[A-Za-z0-9._-]+)?|[^@\\s]+@[^@\\s]+)$" }
        },
        "bot_authors": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identity", "paths"],
            "properties": {
              "identity": { "type": "string", "minLength": 1 },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "extra_denylist": { "$ref": "#/$defs/globs" },
        "title_pattern": { "type": "string" },
        "max_files": { "type": "integer", "minimum": 1, "description": "Stage 1 file limit: 10 by default; a repo may lower it but not raise it." },
        "max_changed_lines": { "type": "integer", "minimum": 1, "description": "Stage 1 changed-line limit: 1,000 by default; a repo may lower it but not raise it." },
        "min_review_confidence": { "$ref": "#/$defs/unit", "description": "Stage 2 review_confidence bar: 0.8 by default; a repo may raise it but not lower it (spec §6.13)." },
        "min_merge_safety_score": { "$ref": "#/$defs/unit", "description": "Stage 2 merge_safety_score bar: 0.7 by default; a repo may raise it but not lower it (spec §6.13)." }
      }
    },
    "approval_mode": { "enum": ["native_approve", "merge_policy_check"] }
  }
}
