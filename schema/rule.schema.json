{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exemplar.internal/schema/rule.schema.json",
  "title": "CodeReviewRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "category", "severity", "owner", "status", "file_patterns", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,79}$" },
    "kind": { "enum": ["exemplar", "compiled", "bug_class"] },
    "category": { "type": "string", "minLength": 1, "maxLength": 40 },
    "severity": { "enum": ["blocking", "important", "suggestion"] },
    "owner": { "type": "string", "pattern": "^@[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?$" },
    "status": { "enum": ["candidate", "shadow", "active", "killed"] },
    "review_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "file_patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "preferred_approach": { "type": "string", "maxLength": 4000 },
    "what_to_flag": { "type": "string", "maxLength": 4000 },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "rule"],
      "properties": {
        "engine": { "enum": ["ast-grep", "semgrep"] },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "fix_policy": { "enum": ["none", "describe", "suggest"] },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doc": { "type": "string", "format": "uri" },
        "comments": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "prs": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents"],
      "properties": {
        "agents": { "type": "boolean" },
        "summary": { "type": "string", "maxLength": 300 }
      }
    },
    "eval_cases": { "type": "string" },
    "model_tier": { "enum": ["standard", "high"] },
    "verify": { "enum": ["single", "quorum"] },
    "context": { "enum": ["full", "text-only"] },
    "eval": { "enum": ["historical", "synthetic"] },
    "linter_map": {
      "description": "Linter check run name (repo config linters) to the linter rule ids that report the same issue as this rule; a finding overlapping one of their annotations is a linter_duplicate (spec §6.10).",
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "compiled" } } },
      "then": { "required": ["matcher"] },
      "else": { "not": { "required": ["matcher"] } }
    }
  ]
}
