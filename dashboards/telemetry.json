{
  "description": "Online-path telemetry from OTel metrics (spec §12.5 Operations): enqueue-to-comment latency, review and model timing, model 429/5xx, GitHub rate limits.",
  "editable": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "p50 and p95 from the review job's enqueue (the webhook's routing) to its comments being posted.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(exemplar_review_queue_to_post_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(exemplar_review_queue_to_post_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Enqueue to first comment",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "p95 review job duration by outcome.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(exemplar_review_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Review duration by outcome",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "Provider calls per second by outcome: rate_limited is 429, server_error is 5xx.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "sum by (provider, outcome) (rate(exemplar_model_calls_total[$__rate_interval]))",
          "legendFormat": "{{provider}} {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Model calls by outcome",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "Share of provider calls that were rate-limited or failed on the provider's side.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (rate(exemplar_model_calls_total{outcome=~\"rate_limited|server_error\"}[$__rate_interval])) / sum by (provider) (rate(exemplar_model_calls_total[$__rate_interval]))",
          "legendFormat": "{{provider}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Model 429 and 5xx share",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "p95 provider latency by stage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(exemplar_model_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Model latency by stage",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "The lowest remaining GitHub rate limit per resource, as last reported by any installation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "min by (resource) (exemplar_github_rate_limit_remaining)",
          "legendFormat": "{{resource}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GitHub rate limit remaining",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "GitHub API responses per second by status class.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "sum by (status_class) (rate(exemplar_github_requests_total[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GitHub responses by status",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "Unfinished River jobs per queue and state; snoozed jobs (waiting on the runner quota or a repo's slots) are scheduled. Every control replica reports the same value, hence max.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "max by (queue, state) (exemplar_queue_depth)",
          "legendFormat": "{{queue}} {{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Queue depth by queue and state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "exemplar-metrics"
      },
      "description": "How long each queue's oldest job due to run, snoozed ones included, has waited to start. Reviews waiting long means the runner quota, a repo's slots or the cluster's capacity is the bottleneck.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "exemplar-metrics"
          },
          "editorMode": "code",
          "expr": "max by (queue) (exemplar_queue_oldest_age_seconds)",
          "legendFormat": "{{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Oldest waiting job by queue",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "exemplar"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Exemplar: telemetry",
  "uid": "exemplar-telemetry",
  "version": 1
}
